{
  "name": "oidc-remote",
  "version": "0.1.0-rc4",
  "description": "MCP stdio and HTTP proxy: OAuth2 client_credentials + K8s SA JWT assertion for Authentik/Envoy gateways — no static mcp.json secrets.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafaelgaspar/oidc-remote"
  },
  "homepage": "https://github.com/rafaelgaspar/oidc-remote",
  "bugs": {
    "url": "https://github.com/rafaelgaspar/oidc-remote/issues"
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "oidc-remote": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "keywords": [
    "mcp",
    "mcp-remote",
    "model-context-protocol",
    "cursor",
    "claude",
    "oauth2",
    "client-credentials",
    "client-assertion",
    "jwt-bearer",
    "kubernetes",
    "service-account",
    "projected-volume",
    "authentik",
    "envoy-gateway",
    "streamable-http",
    "bearer-token",
    "openai-proxy"
  ],
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
